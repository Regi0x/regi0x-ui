# FidonyAa example configuration schema.
# Commit this file. Do NOT put real secrets here.

# ── Application ─────────────────────────────────────────────
APP_ENV=development
APP_LOG_LEVEL=debug
APP_LANGUAGE_DEFAULT=en
APP_LANGUAGES=en,ru
PUBLIC_URL=https://fidonyaa.com
HTTP_ADDR=127.0.0.1:8080

# ── Database ────────────────────────────────────────────────
# Development only. Production credentials should come from a secret source.
DATABASE_URL=
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=5

# ── Twitch ──────────────────────────────────────────────────
TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET is intentionally omitted from this example value set.
TWITCH_BROADCASTER_ID=
TWITCH_REDIRECT_URL=https://auth.fidonyaa.com/oauth/twitch/callback

# ── Media / Gallery ─────────────────────────────────────────
MEDIA_STORAGE_DRIVER=s3
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_BUCKET=fidonyaa-media
MEDIA_PUBLIC_BASE_URL=
MEDIA_MAX_IMAGE_BYTES=15728640
MEDIA_VIEW_RAW_RETENTION_DAYS=14

# ── TTS ─────────────────────────────────────────────────────
TTS_DEFAULT_ENGINE=silero
TTS_DEFAULT_VOICE=xenia
TTS_FALLBACK_MODE=default
TTS_MAX_QUEUE=30
TTS_MAX_TEXT_RUNES=300
TTS_MAX_AUDIO_SECONDS=30
TTS_MAX_CONCURRENT_INFERENCE=1
TTS_AUDIO_TTL=10m
TTS_MODEL_DIR=/var/lib/fidonyaa/tts/models
TTS_AUDIO_DIR=/var/lib/fidonyaa/tts/audio

# ── Bots / Automations ──────────────────────────────────────
BOTS_ENABLED=true
TELEGRAM_ENABLED=false
DISCORD_ENABLED=false
AUTOMATION_DELIVERY_MAX_RETRIES=8

# ── Minecraft ───────────────────────────────────────────────
MINECRAFT_CONTROL_ENABLED=true
MINECRAFT_DATA_ROOT=/var/lib/fidonyaa/minecraft

# ── Observability ───────────────────────────────────────────
METRICS_ENABLED=true
HEALTH_ADDR=127.0.0.1:9090
