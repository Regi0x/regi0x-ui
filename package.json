{
  "name": "regi0x-ui-lab",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "css:build": "npx @tailwindcss/cli -i ./web/assets/app.css -o ./static/app.css --minify",
    "css:watch": "npx @tailwindcss/cli -i ./web/assets/app.css -o ./static/app.css --watch",
    "vendor:htmx": "mkdir -p ./static/vendor && cp ./node_modules/htmx.org/dist/htmx.min.js ./static/vendor/htmx.min.js",
    "assets": "npm run vendor:htmx && npm run css:build"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "tailwindcss": "4.3.0"
  },
  "dependencies": {
    "htmx.org": "2.0.10"
  }
}
